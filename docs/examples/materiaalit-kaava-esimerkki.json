      "id": "field_pinta_ala",
      "key": "pinta_ala_m2",
      "label": "Pinta-ala",
      "type": "number",
      "required": true,
      "showOnSummary": true,
      "unit": "m²",
      "defaultValue": "100"
    },
    {
      "id": "field_maali",
      "key": "kaytettava_maali",
      "label": "Käytettävä maali",
      "type": "product_select",
      "required": true,
      "showOnSummary": true,
      "helpText": "Tuote valitaan Tuotteet-rekisteristä. Korvaa defaultValue oikealla tuote-id:llä."
    },
    {
      "id": "field_maalin_kustannus",
      "key": "maalin_kustannus",
      "label": "Maalin kustannus (laskettu)",
      "type": "computed",
      "required": false,
      "showOnSummary": true,
      "allowManualOverride": true,
      "unit": "€",
      "formula": "pinta_ala_m2 / kaytettava_maali.menekki * kaytettava_maali.ostohinta",
      "effects": [
        { "type": "add_material_fixed" }
      ],
      "helpText": "Kaava laskee hinnan; effects syöttää sen materiaalit-muuttujaan."
    },
    {
      "id": "field_kuljetus",
      "key": "kuljetuslisa",
      "label": "Kuljetuslisä",
      "type": "number",
      "required": false,
      "showOnSummary": true,
      "unit": "€",
      "effects": [
        { "type": "add_material_fixed", "value": 85 }
      ],
      "helpText": "Kiinteä 85 € lisätään materiaaleihin jokaisella laskennalla."
    }
  ]
