  "fields": [
    {
      "id": "field_kiintea_seinapinta",
      "key": "kiintea_seinapinta_ala_m2",
      "label": "Kiinteä seinäpinta-ala",
      "type": "number",
      "required": true,
      "showOnSummary": true,
      "unit": "m²",
      "defaultValue": "120",
      "helpText": "Mitattu pinta-ala ennen aukkoja."
    },
    {
      "id": "field_aukkovahennykset",
      "key": "aukkovahennykset",
      "label": "Aukkovähennykset",
