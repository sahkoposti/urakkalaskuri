      "required": false,
      "showOnSummary": true,
      "unit": "m²",
      "defaultValue": "18"
    },
    {
      "id": "field_laudoitustyyppi",
      "key": "laudoitustyyppi",
      "label": "Laudoitustyyppi",
      "type": "select",
      "required": true,
      "showOnSummary": true,
      "defaultValue": "1.15",
      "options": [
        { "label": "Paneeli", "value": "1.15" },
        { "label": "Lomalaudoitus", "value": "1.25" },
        { "label": "Rimalaudoitus", "value": "1.3" },
        { "label": "Hirsi", "value": "1" }
      ]
    },
    {
      "id": "field_laskenta_seinapinta",
      "key": "laskenta_seinapinta_ala_m2",
      "label": "Seinäpinta-ala (laskettu)",
      "type": "computed",
      "required": false,
      "showOnSummary": true,
      "allowManualOverride": true,
      "unit": "m²",
      "formula": "(kiintea_seinapinta_ala_m2 - aukkovahennykset) * laudoitustyyppi",
      "helpText": "Voit ylikirjoittaa arvon wizardissa nuoli-painikkeella takaisin laskettuun."
    }
  ]
