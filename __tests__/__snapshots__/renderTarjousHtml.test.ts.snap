exports[`renderTarjousHtml business customer: only alv0, no reverse VAT text, no margin/commission 1`] = `
"<!DOCTYPE html>
<html lang="fi">
<head>
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<style>
  @page {
    size: A4 portrait;
    margin: 10mm 18mm 12mm 2.5mm;
    @bottom-right {
      content: "Sivu " counter(page) "/" counter(pages);
      font-family: 'IBM Plex Sans', Arial, Helvetica, sans-serif;
      font-style: italic;
      font-size: 8pt;
      color: #000;
    }
    @top-left-corner { content: ""; background: #C90000; }
    @left-top { content: ""; background: #C90000; }
    @left-middle { content: ""; background: #C90000; }
    @left-bottom { content: ""; background: #C90000; }
    @bottom-left-corner { content: ""; background: #C90000; }
  }
  * { box-sizing: border-box; }
  html, body { margin: 0; padding: 0; }
  body { font-family: 'IBM Plex Sans', Arial, Helvetica, sans-serif; color: #000; font-size: 11pt; line-height: 1.3; }
  .header, .footer { position: fixed; left: 0; right: 0; background: #fff; }
  .header { top: 0; height: 30mm; display: flex; gap: 6mm; align-items: flex-start; border-bottom: 1px solid #000; padding-bottom: 2mm; }
  .header .logo-col { flex: 0 0 45mm; }
  .header .logo { max-width: 45mm; max-height: 14mm; width: auto; height: auto; }
  .header .customer, .header .offer { flex: 1; font-size: 9.5pt; }
  .header .customer .name { font-weight: 700; }
  .header .offer table { border-collapse: collapse; }
  .header .offer td { padding: 0 2mm 0 0; vertical-align: top; }
  .header .offer td.label { color: #333; }
  .footer { bottom: 0; height: 16mm; display: flex; gap: 6mm; border-top: 1px solid #000; padding-top: 2mm; font-size: 8pt; }
  .footer .col { flex: 1; text-align: left; }
  table.layout { width: 100%; border-collapse: collapse; }
  table.layout > thead td, table.layout > tfoot td, table.layout > tbody > tr > td { padding: 0; }
  .spacer-top { height: 34mm; }
  .spacer-bottom { height: 18mm; }
  .spec-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 12px; margin-bottom: 6mm; }
  .spec-card { border: 1px solid #ccc; border-top: 3px solid #C90000; padding: 2.5mm 3mm; page-break-inside: avoid; break-inside: avoid; }
  .spec-card.full { grid-column: 1 / -1; }
  .spec-card h2 { margin: 0 0 1.5mm 0; font-size: 11pt; font-weight: 700; }
  .spec-card table { width: 100%; border-collapse: collapse; font-size: 10pt; }
  .spec-card td { padding: 0.6mm 0; vertical-align: top; }
  .spec-card td.value { text-align: right; padding-left: 3mm; white-space: nowrap; }
  .price-block { display: flex; gap: 12px; margin: 2mm 0 6mm 0; page-break-inside: avoid; break-inside: avoid; }
  .price-block .col { flex: 1; }
  .price-block table { width: 100%; border-collapse: collapse; }
  .price-block td { padding: 0.8mm 0; }
  .price-block td.value { text-align: right; white-space: nowrap; }
  .price-block tr.emphasis td { font-weight: 700; font-size: 12.5pt; border-top: 2px solid #C90000; padding-top: 1.5mm; }
  .additional-info h3 { margin: 0 0 1.5mm 0; font-size: 11pt; break-after: avoid; page-break-after: avoid; }
  .page-break { page-break-before: always; break-before: page; }
  .ktv-title { margin: 0 0 4mm 0; font-size: 14pt; }
  .ktv-page .price-block { max-width: 150mm; }
  .ktv-one-person { font-weight: 700; margin: 4mm 0 2mm 0; }
  .ktv-note { font-size: 9pt; color: #333; }
  body.doc-offer { padding-left: 15.5mm; }
  body.doc-offer .header, body.doc-offer .footer { left: 15.5mm; }

  .doc-section { margin: 0 0 5mm 0; }
  .doc-heading, .offer-line-heading { break-inside: avoid; page-break-inside: avoid; break-after: avoid; page-break-after: avoid; }
  .doc-heading { margin: 3mm 0 1.5mm 0; font-size: 12pt; }
  .offer-line-heading { display: flex; align-items: baseline; gap: 2mm; margin: 3mm 0 2mm 0; font-size: 12pt; }
  .offer-line-title { font-weight: 700; }
  .offer-line-leader { flex: 1 1 auto; border-bottom: 1px dotted #666; min-width: 8mm; height: 0; }
  .offer-line-qty, .offer-line-price { white-space: nowrap; }
  .offer-line-vat { font-size: 8pt; white-space: nowrap; }
  .doc-desc { margin: 0 0 3mm 0; }
  .doc-group { margin: 0 0 3mm 0; break-inside: avoid; page-break-inside: avoid; }
  .doc-group-muuta { margin-top: 4mm; }
  .doc-group-tieto { margin-top: 4mm; padding-top: 2mm; border-top: 1px solid #ccc; }
  .doc-group-title { margin: 0 0 1mm 0; font-weight: 700; }
  .doc-line { margin: 0 0 1mm 0; break-inside: avoid; page-break-inside: avoid; }
  .doc-fields { width: 100%; border-collapse: collapse; margin: 0 0 3mm 0; font-size: 10pt; }
  .doc-fields tr { break-inside: avoid; page-break-inside: avoid; }
  .doc-fields td { padding: 0.6mm 2mm 0.6mm 0; vertical-align: top; border-bottom: 1px solid #eee; }
  .doc-fields td.value { text-align: right; }
  .uk-huomio { margin-top: 4mm; }
  .uk-huomio h3 { margin: 0 0 1.5mm 0; font-size: 11pt; break-after: avoid; page-break-after: avoid; }

  .price-block.offer-totals { justify-content: flex-end; }
  .price-block.offer-totals .col { flex: 0 1 92mm; }
  .offer-delivery { margin: 1mm 0 4mm 0; }
  .offer-vat { width: 100%; max-width: 140mm; border-collapse: collapse; margin: 2mm 0 6mm 0; break-inside: avoid; page-break-inside: avoid; }
  .offer-vat tr { break-inside: avoid; page-break-inside: avoid; }
  .offer-vat th, .offer-vat td { padding: 0.8mm 2mm 0.8mm 0; text-align: left; }
  .offer-vat th.num, .offer-vat td.num { text-align: right; white-space: nowrap; }
  .offer-vat th { border-bottom: 1px solid #000; font-size: 9pt; }
  .offer-sign { display: grid; grid-template-columns: 1fr 1fr; column-gap: 12mm; width: 100%; margin: 6mm 0 4mm 0; break-inside: avoid; page-break-inside: avoid; }
  .offer-sign-role { margin: 0 0 1.5mm 0; font-weight: 700; }
  .offer-sign-name { min-width: 0; }
  .offer-sign-pen { break-inside: avoid; page-break-inside: avoid; }
  .offer-sign-detail { margin: 0 0 1mm 0; }
  .offer-sign-label { margin: 3mm 0 0 0; }
  .offer-sign-line { height: 10mm; border-bottom: 1px solid #000; margin: 0 0 1mm 0; break-inside: avoid; page-break-inside: avoid; }
  .ktv-rate-sentence { margin: 0 0 3mm 0; }
  table.offer-cols-head, table.offer-line-heading { width: 100%; table-layout: fixed; border-collapse: collapse; }
  table.offer-cols-head { margin: 3mm 0 0 0; break-inside: avoid; page-break-inside: avoid; break-after: avoid; page-break-after: avoid; }
  table.offer-line-heading { display: table; margin: 0 0 2mm 0; break-inside: avoid; page-break-inside: avoid; }
  table.offer-cols-head .c-qty, table.offer-line-heading .c-qty { width: 18mm; }
  table.offer-cols-head .c-unit, table.offer-line-heading .c-unit { width: 16mm; }
  table.offer-cols-head .c-unitprice, table.offer-line-heading .c-unitprice { width: 28mm; }
  table.offer-cols-head .c-vat, table.offer-line-heading .c-vat { width: 26mm; }
  table.offer-cols-head .c-total, table.offer-line-heading .c-total { width: 32mm; }
  table.offer-cols-head th, table.offer-cols-head td, table.offer-line-heading th, table.offer-line-heading td { padding: 0.6mm 1.5mm 0.6mm 0; vertical-align: baseline; text-align: left; }
  table.offer-cols-head th.num, table.offer-cols-head td.num, table.offer-line-heading th.num, table.offer-line-heading td.num { text-align: right; white-space: nowrap; }
  table.offer-cols-head th {
    font-size: 8pt;
    font-weight: 600;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: #555;
    border-bottom: 0.25mm solid #ccc;
  }
  table.offer-line-heading td { border-bottom: 0.2mm solid #eee; padding-top: 1.2mm; padding-bottom: 1.2mm; }
  table.offer-line-heading td.offer-line-title { font-weight: 700; font-size: 12pt; color: #000; }
  table.offer-line-heading .offer-line-vat { font-size: 10pt; font-weight: 400; }
  .offer-section { margin: 0 0 4mm 0; }
  .offer-section .doc-fields td { line-height: 1.45; padding: 1mm 2mm 1mm 0; }
  .offer-section .doc-group { margin: 0 0 2.5mm 0; }
  .header { align-items: flex-start; }
  .header .offer td { line-height: 1.35; vertical-align: baseline; }
  .price-block.offer-totals { margin: 4mm 0 5mm 0; }
</style>
</head>
<body class="doc-offer">
<div class="header">
  <div class="logo-col"><img class="logo" src="data:image/png;base64,AAAA" alt="" /></div>
  <div class="customer"><div class="name">Matti Meikäläinen</div>Testitie 1, 20100 Turku<br />040 000 0000</div>
  <div class="offer"><table><tr><td class="label">Tarjousnumero</td><td>10285</td></tr><tr><td class="label">Päiväys</td><td>10.10.2026</td></tr><tr><td class="label">Voimassa</td><td>10.11.2026</td></tr></table></div>
</div>
<div class="footer">
  <div class="col">ColoRajaton Oy<br />Toivonlinnantie 350<br />21500 Piikkiö</div>
  <div class="col">www.colorajaton.fi<br />info@colorajaton.fi</div>
  <div class="col">Y-tunnus: 3224017-2<br />Puh. +358 40 938 9403</div>
</div>
<table class="layout">
<thead><tr><td class="spacer-top"></td></tr></thead>
<tfoot><tr><td class="spacer-bottom"></td></tr></tfoot>
<tbody><tr><td>
<section class="doc-section offer-section"><table class="offer-cols-head"><colgroup><col class="c-name" /><col class="c-qty" /><col class="c-unit" /><col class="c-unitprice" /><col class="c-vat" /><col class="c-total" /></colgroup><thead><tr><th>Nimike</th><th class="num">Määrä</th><th>Yks.</th><th class="num">A-hinta</th><th class="num">Alv-%</th><th class="num">Yht</th></tr></thead></table><table class="offer-line-heading"><colgroup><col class="c-name" /><col class="c-qty" /><col class="c-unit" /><col class="c-unitprice" /><col class="c-vat" /><col class="c-total" /></colgroup><tbody><tr><td class="offer-line-title">Ulkomaalaus</td><td class="num offer-line-qty">1</td><td class="offer-line-unit"></td><td class="num offer-line-unitprice">1 000,00 €</td><td class="num offer-line-vat">Alv 0 %</td><td class="num offer-line-price">1 000,00 €</td></tr></tbody></table><div class="doc-group doc-group-muuta"><p class="doc-group-title">Muuta</p><p class="doc-line">Sisältää telineet.</p></div><table class="doc-fields"><tr><td>Kiinteä seinäpinta-ala</td><td class="value">120 m²</td></tr><tr><td>Laudoitustyyppi</td><td class="value">Paneeli</td></tr><tr><td>Työn arvioitu kesto</td><td class="value">4 työpäivää</td></tr></table></section>
<div class="price-block offer-totals"><div class="col"><table><tr class="emphasis"><td>Loppusumma (Alv 0 %)</td><td class="value">2 000,00 €</td></tr></table></div></div>
<div class="offer-sign"><p class="offer-sign-role">Myyjä</p><p class="offer-sign-role">Tilaaja</p><div class="offer-sign-name"><p class="offer-sign-detail">ColoRajaton Oy</p><p class="offer-sign-detail">Puh. +358 40 938 9403</p><p class="offer-sign-detail">info@colorajaton.fi</p></div><div class="offer-sign-name"><p class="offer-sign-detail">Matti Meikäläinen</p></div><div class="offer-sign-pen"><p class="offer-sign-label">Allekirjoitus</p><div class="offer-sign-line"></div></div><div class="offer-sign-pen"><p class="offer-sign-label">Allekirjoitus</p><div class="offer-sign-line"></div></div><div class="offer-sign-pen"><p class="offer-sign-label">Päiväys</p><div class="offer-sign-line"></div></div><div class="offer-sign-pen"><p class="offer-sign-label">Päiväys</p><div class="offer-sign-line"></div></div></div>
</td></tr></tbody>
</table>
</body>
</html>"
`;

