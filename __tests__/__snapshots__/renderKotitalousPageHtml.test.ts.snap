exports[`renderKotitalousPageHtml n=2 and n=3 change the person rows and the default estimate wording 1`] = `
"<section class="ktv-page page-break">
<h2 class="ktv-title">Kotitalousvähennyslaskelma (2 hlö)</h2>
<p class="ktv-rate-sentence">Vähennystä saa arvonlisäverollisesta työn osuudesta 40 %, max 2 100,00 € / henkilö vuodessa; omavastuu 150,00 € / henkilö vuodessa.</p>
<div class="ktv-block"><table class="ktv-table"><colgroup><col /><col class="c-basis" /><col class="c-amount" /></colgroup><thead><tr><th>1. Tarjouksen hinta</th><th class="num">Peruste</th><th class="num">Summa</th></tr></thead><tbody><tr><td>Yhteensä sis. alv</td><td class="basis">sivun 1 loppusumma</td><td class="num">2 510,00 €</td></tr><tr class="sub minor"><td>josta materiaalit (sis. alv)</td><td class="basis">ei vähennyskelpoinen</td><td class="num">502,00 €</td></tr><tr class="sub"><td>josta työn osuus (sis. alv)</td><td class="basis">vähennyksen pohja</td><td class="num">2 008,00 €</td></tr></tbody></table></div>
<div class="ktv-block"><table class="ktv-table"><colgroup><col /><col class="c-basis" /><col class="c-amount" /></colgroup><thead><tr><th>2. Vähennyksen laskenta</th><th class="num">Peruste</th><th class="num">Summa</th></tr></thead><tbody><tr><td>Kotitalousvähennys 40 % työn osuudesta</td><td class="basis">40 % × 2 008,00 €</td><td class="num">803,20 €</td></tr><tr><td>Omavastuu (2 hlö)</td><td class="basis">2 × 150,00 €</td><td class="num">−300,00 €</td></tr><tr class="minor"><td>Enimmäismäärä yhteensä (2 hlö)</td><td class="basis">2 × 2 100,00 €</td><td class="num">4 200,00 €</td></tr><tr class="result"><td>Arvioitu kotitalousvähennys (2 hlö)</td><td class="basis"></td><td class="num">503,20 €</td></tr></tbody></table></div>
<div class="ktv-block"><table class="ktv-table"><colgroup><col /><col class="c-basis" /><col class="c-amount" /></colgroup><thead><tr><th>3. Asiakkaan maksettavaksi jää (arvio)</th><th class="num">Peruste</th><th class="num">Summa</th></tr></thead><tbody><tr><td>Yhteensä sis. alv</td><td class="basis"></td><td class="num">2 510,00 €</td></tr><tr><td>Arvioitu kotitalousvähennys (2 hlö)</td><td class="basis"></td><td class="num">−503,20 €</td></tr></tbody></table></div>
<div class="price-block ktv-final"><div class="col"><table><tr class="emphasis"><td>Arvioitu hinta vähennyksen jälkeen</td><td class="value">2 006,80 €</td></tr></table></div></div>
<p class="ktv-note">Kotitalousvähennys on arvio 2 henkilölle. Vähennyksestä on vähennetty omavastuu ja se on rajattu henkilökohtaiseen vuosittaiseen enimmäismäärään. Materiaalit eivät ole vähennyskelpoisia. Lopullisen vähennyksen määrää Verohallinto.</p>
</section>"
`;

