exports[`renderKotitalousPageHtml n=2 and n=3 change the person rows and the default estimate wording 1`] = `
"<section class="ktv-page page-break">
<h2 class="ktv-title">Kotitalousvähennyslaskelma (2 hlö)</h2>
<p class="ktv-rate-sentence">Vähennystä saa arvonlisäverollisesta työn osuudesta 40 %, max 2 100,00 € / henkilö vuodessa; omavastuu 150,00 € / henkilö vuodessa.</p>
<div class="ktv-block"><table class="ktv-table"><colgroup><col /><col class="c-amount" /></colgroup><thead><tr><th>1. Tarjouksen hinta</th><th class="num">Summa</th></tr></thead><tbody><tr><td>Yhteensä sis. alv</td><td class="num">2 510,00 €</td></tr><tr class="sub minor"><td>josta materiaalit (sis. alv)</td><td class="num">502,00 €</td></tr><tr class="sub"><td>josta työn osuus (sis. alv)</td><td class="num">2 008,00 €</td></tr></tbody></table></div>
<div class="ktv-block"><table class="ktv-table"><colgroup><col /><col class="c-amount" /></colgroup><thead><tr><th>2. Vähennyksen laskenta</th><th class="num">Summa</th></tr></thead><tbody><tr><td>Kotitalousvähennys 40 % työn osuudesta</td><td class="num">803,20 €</td></tr><tr><td>Omavastuu (1 hlö)</td><td class="num">−150,00 €</td></tr><tr class="result"><td>Arvioitu kotitalousvähennys (1 hlö)</td><td class="num">653,20 €</td></tr><tr class="result final"><td>Arvioitu hinta vähennyksen jälkeen</td><td class="num">1 856,80 €</td></tr></tbody></table></div>
<p class="ktv-hint">Laskelmassa on käytetty yhden henkilön omavastuuta ja enimmäismäärää, koska vähennys ei vaadi useampaa.</p>
<p class="ktv-note">Vähennyksestä on vähennetty omavastuu ja se on rajattu henkilökohtaiseen vuosittaiseen enimmäismäärään. Materiaalit eivät ole vähennyskelpoisia. Lopullisen vähennyksen määrää Verohallinto.</p>
</section>"
`;

