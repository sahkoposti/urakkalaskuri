{
  "expo": {
    "name": "Urakkalaskuri",
    "slug": "urakkalaskuri",
    "version": "1.3.5",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "urakkalaskuri",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": false
    },
    "android": {
      "package": "fi.colorajaton.urakkalaskuri",
      "softwareKeyboardLayoutMode": "pan",
      "adaptiveIcon": {
        "backgroundColor": "#FFFFFF",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      }
    },
    "plugins": [
      "expo-router",
      "expo-sqlite",
      [
        "expo-image-picker",
        {
          "photosPermission": "Sovellus tarvitsee kuvat liitteiden valitsemiseen.",
          "cameraPermission": "Sovellus tarvitsee kameran liitekuvien ottamiseen.",
          "microphonePermission": false
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/logo-colorajaton.png",
          "resizeMode": "contain",
          "backgroundColor": "#FFFFFF",
          "imageWidth": 280
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "619a82c7-2cd0-444a-b521-28025e496c20"
      }
    },
    "owner": "eemilt00"
  }
}
